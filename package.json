{
  "name": "stable",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven QA bot that autonomously navigates web apps, discovers user journeys, and detects regressions",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @stable/server dev",
    "build": "pnpm --filter @stable/server build",
    "start": "pnpm --filter @stable/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && oxlint && oxfmt --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "ci": "pnpm check && pnpm test:run"
  },
  "devDependencies": {
    "oxlint": "^1.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
