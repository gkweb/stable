# LLM Provider
LLM_PROVIDER=anthropic              # anthropic | openai | gemini
LLM_MODEL=claude-sonnet-4-5-20250929  # For gemini free tier: gemini-2.0-flash
LLM_BASE_URL=                       # Optional: custom endpoint (Azure, Groq, Ollama, etc.)
LLM_API_KEY=

# Provider-specific keys (fallback when LLM_API_KEY is not set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                     # Free at https://aistudio.google.com/apikey

# Server
PORT=3000
HOST=0.0.0.0
API_KEY=                            # Optional: protect API with bearer token

# Storage
DATA_DIR=./data

# Agent defaults
MAX_JOURNEYS=10
MAX_STEPS_PER_JOURNEY=50
MAX_DURATION_MINUTES=30

# Browser
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720
CHROMIUM_PATH=                      # Optional: path to Chromium binary (auto-detected if not set)

# Logging
LOG_LEVEL=info
